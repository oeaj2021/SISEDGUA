# ==============================================================================
# SISEDGUA - VARIABLES DE ENTORNO PARA DOKPLOY (PRODUCCIÓN)
# Copia y pega este bloque en Dokploy > Tu Servicio Compose / App > Environment
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=production
PORT=3001
TZ=America/Caracas

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sisedgua
DB_USER=sisedgua_admin
DB_PASS=genera_un_password_seguro_aqui_2026

# Seguridad y Autenticación (HMAC-SHA256 / JWT Secret)
# Generar con: openssl rand -hex 32
JWT_SECRET=genera_un_jwt_secret_hex_64_caracteres_minimo

# Semilla de Inicialización del Administrador
DEFAULT_ADMIN_EMAIL=admin@sisedgua.ve
DEFAULT_ADMIN_PASS=CambiaEstaClaveTemporal2026!
DEFAULT_ADMIN_NAME="Administrador Sala Situacional CDCE ESTADAL GUÁRICO"

# Dominios Públicos Oficiales en Dokploy
FRONTEND_URL=https://asis.sisedgua.site
COMUC_URL=https://comuc.sisedgua.site

# Flags Operacionales (false en producción)
IGNORE_SCHEDULE=false
